# Absolute path to a local llama.cpp GGUF model (required only for LLM fallback).
MODEL_PATH=/path/to/model.gguf
# Context size passed to llama-cpp-python.
N_CTX=8192
# Number of GPU layers; 0 means CPU-only.
N_GPU_LAYERS=0
# CPU threads; 0 lets llama.cpp choose automatically.
N_THREADS=0
# Maximum source characters sent to the local model.
MAX_INPUT_CHARS=24000
# Sampling temperature, clamped to 0.0-0.1.
TEMPERATURE=0.1
# Minimum delay between requests/pages (seconds).
REQUEST_DELAY_SECONDS=1.0
# Default directory for generated output.
OUTPUT_DIR=output
# Optional installed REA CLI executable.
REA_COMMAND=
# Loopback Chrome DevTools Protocol endpoint for REA browser analysis.
REA_CDP_ENDPOINT=http://127.0.0.1:9222
# Network request timeout in seconds.
FETCH_TIMEOUT=30

# Limits: 0 = unlimited
MAX_RESPONSE_BYTES=0
SUBAGENTS_MAX_PROBES=0
SUBAGENTS_MAX_SCRIPTS=0
REQUEST_DELAY_SECONDS=0

# peke ask: SearXNG instance (needs "json" in search.formats). Unset = auto-detect localhost:8080/8888
SEARXNG_URL=
