# Path to GGUF model file for local llama.cpp extraction
MODEL_PATH=/path/to/model.gguf

# Optional REA server URL for automated endpoint discovery (MCP server or CLI proxy)
REA_SERVER_URL=http://localhost:8000

# Default timeout in seconds for web fetching
FETCH_TIMEOUT=30

# Default temperature for LLM extraction (constrained to 0.0 - 0.1)
LLM_TEMPERATURE=0.1
